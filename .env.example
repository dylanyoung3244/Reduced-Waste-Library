# Required: 32+ byte random secret for signing staff JWTs
JWT_SECRET="replace-with-openssl-rand-hex-32"

# Required for Cloud Scheduler / cron endpoint authentication
CRON_SECRET="replace-with-openssl-rand-hex-32"

# Required for Power BI M2M analytics endpoint (/api/export/analytics)
POWERBI_API_KEY="replace-with-strong-api-key"

# Google Cloud Storage bucket for category images and procurement receipts
GCS_BUCKET_NAME="oscer-procurement-receipts-staging"

# Optional: Override Firestore database ID (defaults to '(default)')
FIRESTORE_DATABASE_ID="(default)"

# Optional: Initial bootstrap password when seeding a completely empty database
INITIAL_ADMIN_PASSWORD=""

# Optional: SMTP configuration for automated request & low-stock emails
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
NOTIFICATION_EMAIL="oscer@hawaiicounty.gov"
